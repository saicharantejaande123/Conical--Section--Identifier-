def run_single_test(test_name, config, expected_type):
    """
    Run one conic through the mathematical engine
    and compare the detected result with the expected result.
    """

    # Build mathematical model
    a, h, b, g, f, c, Q, d, C = build_model(config)

    # Eigenvalue analysis
    eigenvalues, P = eigen_analysis(Q)

    # Classification
    result = classify_conic(
        a, h, b, g, f, c,
        Q, d, C,
        eigenvalues,
        P
    )

    detected_type = result.classification

    # Check result
    passed = (
        detected_type.lower()
        == expected_type.lower()
    )

    return {
        "Test": test_name,
        "Expected": expected_type,
        "Detected": detected_type,
        "Status": "PASS" if passed else "FAIL",
        "Eigenvalue 1": round(
            eigenvalues[0], 4
        ),
        "Eigenvalue 2": round(
            eigenvalues[1], 4
        ),
        "Rotation": round(
            result.rotation_angle, 2
        )
    }


